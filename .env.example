# ==============================================================================
# Food Delivery Carbon Footprint Tracker - Environment Configuration
# ==============================================================================

# Server Port and Environment
PORT=3000
NODE_ENV=development

# SQLite Database File Path
DB_PATH=./database/carbon_tracker.sqlite

# OpenStreetMap Nominatim Geocoding Provider
# NOTE: Nominatim requires a descriptive User-Agent header with contact/project info
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=FoodDeliveryCarbonTracker/1.0 (college-project; educational-demo)

# OpenStreetMap OSRM Routing Service
# Default is the public demo server. In production, a self-hosted OSRM instance can be set here.
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_PROFILE=driving

# External API Timeout (milliseconds)
API_TIMEOUT_MS=8000

# Optional Traffic-Aware Routing Provider (e.g. Google Maps Routes API)
# Leave empty to use free OpenStreetMap OSRM routing.
# If provided, the backend can optionally route via Google Routes API.
GOOGLE_MAPS_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
ROUTE_RATE_LIMIT_WINDOW_MS=60000
ROUTE_RATE_LIMIT_MAX_REQUESTS=30
